+namespace Shop.Application.Orders;
+
+public sealed class PriceCalculator
+{
+    public decimal Subtotal(Order order) =>
+        order.Lines.Sum(line => line.UnitPrice * line.Quantity);
+
+    public decimal DiscountAmount(Order order)
+    {
+        var subtotal = Subtotal(order);
+        var percentage = order.Discount?.Percentage ?? 0m;
+        return subtotal * percentage / 100m;
+    }
+
+    public decimal Total(Order order) => Subtotal(order) - DiscountAmount(order);
+}
